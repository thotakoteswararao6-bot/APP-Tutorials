prices = [500,1200,2500,900,1500]
def discount(price):
    if price > 1000:
        return price*0.8
    return price
eligible =list(filter(lambda x: x >1000, prices))
print("Products above 1000:",eligible)
new_prices=list(map(discount, prices))
print("Prices after Discount:",new_prices)
print("\nExplanation:")
print("discount() is a pure function.")
print("It returns a new value without modifying the original list.")
